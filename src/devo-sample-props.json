  "scenes": [
    {
      "voiceover": "कभी लगा कि ज़िंदगी में अचानक सब बदल गया? काम, लोग, सोच, सब कुछ?",
      "heroes": [
        {
          "img": "lifechange",
          "kind": "photo"
        }
      ],
      "title": "9 अध्याय",
      "titleSub": "VIMSHOTTARI DASHA",
      "labels": [
        {
          "top": "अचानक",
          "bottom": "सब बदल गया?",
          "word": "अचानक"
        },
        {
          "top": "काम · लोग · सोच",
          "bottom": "सब कुछ",
          "word": "काम,"
        }
      ],
      "visual": "devo",
      "startMs": 0,
      "endMs": 5920
    },
    {
      "voiceover": "ज्योतिष कहता है, शायद आपकी ज़िंदगी का अध्याय बदल गया। और ये अध्याय पहले से तय क्रम में चलते हैं।",
      "heroes": [
        {
          "img": "book",
          "kind": "object"
        }
      ],
      "labels": [
        {
          "top": "ज़िंदगी का",
          "bottom": "अध्याय बदला",
          "word": "अध्याय"
        },
        {
          "top": "पहले से",
          "bottom": "तय क्रम",
          "word": "तय"
        }
      ],
      "visual": "devo",
      "startMs": 6200,
      "endMs": 13150
    },
    {
      "voiceover": "इसे विंशोत्तरी दशा कहते हैं। एक सौ बीस साल का चक्र, जिसमें नौ ग्रह बारी-बारी से आपकी ज़िंदगी की कमान संभालते हैं।",
      "heroes": [
        {
          "img": "book",
          "kind": "object"
        }
      ],
      "dial": {
        "word": "बीस",
        "planetsWord": "नौ"
      },
      "labels": [
        {
          "top": "विंशोत्तरी",
          "bottom": "दशा",
          "word": "विंशोत्तरी"
        },
        {
          "top": "120 साल",
          "bottom": "का चक्र",
          "word": "बीस"
        },
        {
          "top": "9 ग्रह",
          "bottom": "बारी-बारी",
          "word": "नौ"
        }
      ],
      "visual": "devo",
      "startMs": 13430,
      "endMs": 21190
    },
    {
      "voiceover": "हर अध्याय की लंबाई अलग है। शुक्र की महादशा बीस साल चलती है, शनि की उन्नीस, और सूर्य की सिर्फ़ छह।",
      "heroes": [
        {
          "img": "book",
          "kind": "object"
        },
        {
          "img": "shukra",
          "kind": "deity",
          "word": "शुक्र"
        },
        {
          "img": "shani",
          "kind": "deity",
          "word": "शनि"
        },
        {
          "img": "surya",
          "kind": "deity",
          "word": "सूर्य"
        }
      ],
      "labels": [
        {
          "top": "हर अध्याय",
          "bottom": "अलग लंबाई",
          "word": "लंबाई"
        },
        {
          "top": "शुक्र",
          "bottom": "20 साल",
          "word": "शुक्र"
        },
        {
          "top": "शनि",
          "bottom": "19 साल",
          "word": "शनि"
        },
        {
          "top": "सूर्य",
          "bottom": "सिर्फ़ 6 साल",
          "word": "सूर्य"
        }
      ],
      "visual": "devo",
      "startMs": 21470,
      "endMs": 28640
    },
    {
      "voiceover": "आपकी किताब किस अध्याय से शुरू होगी, ये तय करता है जन्म के समय चंद्रमा का नक्षत्र। इसीलिए भाई-बहनों की दशाएँ भी अलग चलती हैं।",
      "heroes": [
        {
          "img": "chandra",
          "kind": "deity"
        },
        {
          "img": "siblings",
          "kind": "photo",
          "word": "भाई-बहनों"
        }
      ],
      "labels": [
        {
          "top": "पहला अध्याय",
          "bottom": "कौन सा?",
