        },
        {
          "top": "जन्म का",
          "bottom": "चंद्र नक्षत्र",
          "word": "नक्षत्र।"
        },
        {
          "top": "भाई-बहन",
          "bottom": "अलग दशा",
          "word": "भाई-बहनों"
        }
      ],
      "visual": "devo",
      "startMs": 28920,
      "endMs": 38020
    },
    {
      "voiceover": "और क्योंकि पूरा चक्र एक सौ बीस साल का है, ज़्यादातर लोग अपनी किताब के सारे अध्याय कभी नहीं पढ़ पाते।",
      "heroes": [
        {
          "img": "book",
          "kind": "object"
        }
      ],
      "dial": {
        "word": "एक",
        "lifeWord": "ज़्यादातर"
      },
      "labels": [
        {
          "top": "120 साल",
          "bottom": "की किताब",
          "word": "एक"
        },
        {
          "top": "पूरी कोई",
          "bottom": "नहीं पढ़ता",
          "word": "कभी"
        }
      ],
      "visual": "devo",
      "startMs": 38300,
      "endMs": 44660
    },
    {
      "voiceover": "आप अभी किस ग्रह की महादशा में हैं? कमेंट कीजिए। और अगली रील में बताऊँगा, कमज़ोर ग्रह कैसे सबसे बड़ी ताकत बन जाता है। फॉलो कर लीजिए।",
