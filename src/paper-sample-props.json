    {
      "visual": "hook",
      "voiceover": "इस वक़्त तीन राशियों पर साढ़े साती चल रही है। क्या आपकी राशि भी उनमें है?",
      "kicker": "इस वक़्त",
      "headline": "3 राशियों पर",
      "accent": "साढ़े साती",
      "questionWord": "क्या",
      "startMs": 0,
      "endMs": 4550
    },
    {
      "visual": "loop",
      "voiceover": "नाम आख़िर में बताऊँगा, पहले समझिए कि ये है क्या।",
      "headline": "नाम आख़िर में",
      "label": "पहले समझिए",
      "labelWord": "समझिए",
      "startMs": 4830,
      "endMs": 8630
    },
    {
      "visual": "cycle",
      "voiceover": "शनि एक राशि में करीब ढाई साल रहते हैं। जब वो आपकी चंद्र राशि से ठीक पहले, उसी पर, और ठीक बाद वाली राशि से गुज़रते हैं, तो ये साढ़े सात साल साढ़े साती कहलाते हैं।",
      "unitWord": "ढाई",
      "steps": [
        {
          "label": "ठीक पहले",
          "word": "पहले,"
        },
        {
          "label": "आपकी राशि",
          "word": "उसी"
        },
        {
          "label": "ठीक बाद",
          "word": "बाद"
        }
      ],
      "totalWord": "सात",
      "startMs": 8910,
      "endMs": 20690
    },
    {
      "visual": "orbit",
      "voiceover": "और ये लगभग हर तीस साल में आती है, यानी ज़्यादातर लोगों की ज़िंदगी में दो या तीन बार।",
      "stat": "30",
      "statSuffix": "साल",
      "statWord": "तीस",
      "lifeWord": "ज़िंदगी",
      "startMs": 20970,
      "endMs": 25710
    },
    {
      "visual": "trainer",
      "voiceover": "शनि को डर की तरह मत देखिए। वो उस ट्रेनर जैसे हैं जो वज़न बढ़ाता है, ताकि आप मज़बूत बनें। मेहनत, अनुशासन और धैर्य, यही इस समय की कुंजी है।",
      "headline": "डर नहीं,",
      "accent": "ट्रेनर",
      "trainerWord": "ट्रेनर",
      "keys": [
        {
          "text": "मेहनत",
          "word": "मेहनत,"
        },
        {
          "text": "अनुशासन",
          "word": "अनुशासन"
        },
        {
          "text": "धैर्य",
          "word": "धैर्य,"
        }
      ],
      "startMs": 25990,
      "endMs": 36990
    },
    {
      "visual": "reveal",
      "voiceover": "अभी साढ़े साती है मेष पर, जहाँ इसकी शुरुआत है; मीन पर, जो बीच के चरण में है; और कुंभ पर, जिसका आख़िरी चरण जून दो हज़ार सत्ताईस में पूरा होगा।",
      "headline": "अभी साढ़े साती",
      "rows": [
        {
