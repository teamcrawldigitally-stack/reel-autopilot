# Copy to .env for local runs on your Mac. On GitHub, add these as repository secrets instead.
# Nothing here is paid.

# Instagram (free, from developers.facebook.com - see README)
IG_USER_ID=
IG_ACCESS_TOKEN=
# IG_GRAPH_VERSION=v26.0

# Claude login token for scheduled runs (from `claude setup-token`, uses your Claude Pro/Max plan).
# For manual runs on your Mac you can leave it empty if you're logged in to Claude Code.
CLAUDE_CODE_OAUTH_TOKEN=

# Sarvam AI (Bulbul Hindi voices) - free ₹100 credit on signup: indus.sarvam.ai/key-management
SARVAM_API_KEY=
