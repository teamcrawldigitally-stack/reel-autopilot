{
  "name": "reel-autopilot",
  "version": "1.0.0",
  "description": "Daily Instagram Reel autopilot: research -> script -> voiceover -> Remotion render -> post",
  "scripts": {
    "daily": "node pipeline/run-daily.mjs",
    "dry-run": "node pipeline/run-daily.mjs --dry-run",
    "sample": "node pipeline/run-daily.mjs --dry-run --script samples/sample-script.json",
    "studio": "remotion studio src/index.ts",
    "sfx": "node pipeline/make-sfx.mjs",
    "typecheck": "tsc --noEmit",
    "models": "mkdir -p models && curl -sSL -o models/kokoro-v1.0.onnx https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0/kokoro-v1.0.onnx && curl -sSL -o models/voices-v1.0.bin https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0/voices-v1.0.bin",
    "astro-reel": "node pipeline/make-astro-reel.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/mukta": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/rozha-one": "^5.3.0",
    "@remotion/captions": "^4.0.540",
    "@remotion/cli": "^4.0.540",
    "@remotion/media": "^4.0.540",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.540"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "private": true,
  "type": "module"
}
